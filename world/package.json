{
  "name": "cortico-world-soft-voice",
  "version": "0.4.4",
  "type": "module",
  "description": "轻量化本地语音引擎：Qwen3-TTS 小模型离线发声，无需语音 API key；核显/独显可选、流式播放、气泡同步、低功耗休眠与可视化诊断。RTX 4050 实测专用显存约 1 GiB；模型需另行一键部署。",
  "license": "MIT",
  "author": "Asryto",
  "keywords": [
    "cortico-world",
    "coopanion",
    "tts",
    "qwen3-tts",
    "vulkan",
    "local-voice"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "轻量化本地语音引擎",
    "consoleClient": "dist/console-0.4.3.js",
    "consoleStyle": "dist/console-0.4.3.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlet20252025-cloud/coopanion-soft-voice.git",
    "directory": "world"
  },
  "homepage": "https://github.com/scarlet20252025-cloud/coopanion-soft-voice#readme",
  "bugs": {
    "url": "https://github.com/scarlet20252025-cloud/coopanion-soft-voice/issues"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
