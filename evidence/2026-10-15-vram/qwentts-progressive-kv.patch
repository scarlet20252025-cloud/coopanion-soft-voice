+#include "../src/pipeline-tts.cpp"
+#include <vector>
+#include <cstring>
+#include <cstdio>
+int main() {
+    PipelineTTS pt = {};
+    ggml_backend_load_all();
+    pt.bp = backend_init("KVTest");
+    if (!pt.bp.backend) return 2;
+    pt.backend = pt.bp.backend;
+    pt.sched = backend_sched_new(pt.bp, 1024);
+    pt.talker_context_limit = 1024;
+    if (!pt.sched || !kv_cache_init(&pt.talker_kv, 28, 8, 128, 256, 1, pt.backend)) return 3;
+    for (int old_capacity : {256, 512, 768}) {
+        const int target = old_capacity + 256;
+        for (int layer = 0; layer < 28; ++layer) {
+            for (int v = 0; v < 2; ++v) {
+                ggml_tensor * t = v ? kv_cache_v(&pt.talker_kv, 0, layer) : kv_cache_k(&pt.talker_kv, 0, layer);
+                std::vector<float> data((size_t) ggml_nelements(t));
+                for (size_t i = 0; i < data.size(); ++i) data[i] = (float) ((int)(i % 1301) - 650 + layer * 3 + v);
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(float));
+            }
+        }
+        pt.talker_kv.cur_len[0] = old_capacity;
+        if (!pipeline_tts_grow_kv(&pt, target)) return 4;
+        if (pt.talker_kv.max_seq_len != target || pt.talker_kv.cur_len[0] != old_capacity) return 5;
+        for (int layer = 0; layer < 28; ++layer) {
+            for (int v = 0; v < 2; ++v) {
+                ggml_tensor * t = v ? kv_cache_v(&pt.talker_kv, 0, layer) : kv_cache_k(&pt.talker_kv, 0, layer);
+                std::vector<float> data((size_t) ggml_nelements(t));
+                ggml_backend_tensor_get(t, data.data(), 0, data.size() * sizeof(float));
+                for (int h = 0; h < 8; ++h) for (int row = 0; row < target; ++row) for (int d = 0; d < 128; ++d) {
+                    const size_t old_i = ((size_t) h * old_capacity + row) * 128 + d;
+                    const size_t new_i = ((size_t) h * target + row) * 128 + d;
+                    const float expected = row < old_capacity ? (float) ((int)(old_i % 1301) - 650 + layer * 3 + v) : 0.f;
+                    if (data[new_i] != expected) {
+                        fprintf(stderr,"copy mismatch layer=%d v=%d head=%d row=%d d=%d\n",layer,v,h,row,d);
+                        return 6;
+                    }
+                }
+            }
+        }
+        printf("verified capacity %d: 56 tensors, all live FP32 rows bit-exact, padded tail zero\n", target);
+    }
+    if (pipeline_tts_grow_kv(&pt, 1025) || pt.talker_kv.max_seq_len != 1024) return 7;
+    kv_cache_free(&pt.talker_kv);
+    ggml_backend_sched_free(pt.sched);
+    backend_release(pt.bp.backend, pt.bp.cpu_backend);
+    puts("KV growth and context overflow guard passed");
