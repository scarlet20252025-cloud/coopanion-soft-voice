+// Grow at the existing 256-position attention boundary. All K/V values stay
+// FP32 on the selected device; no host round trip and no sliding/truncation.
+static bool pipeline_tts_grow_kv(PipelineTTS * pt, int needed) {
+    KVCache & old = pt->talker_kv;
+    const int capacity = (needed + 255) / 256 * 256;
+    if (capacity <= old.max_seq_len) return true;
+    if (capacity > pt->talker_context_limit || old.n_sets != 1) return false;
+    ggml_backend_synchronize(pt->backend);
+    KVCache next = {};
+    if (!kv_cache_init(&next, old.n_layers, old.n_kv_heads, old.head_dim,
+                       capacity, 1, pt->backend)) return false;
+    const int used = old.cur_len[0];
+    const int max_nodes = old.n_layers * 16 + 64;
+    ggml_init_params gp = {ggml_tensor_overhead() * (size_t) (old.n_layers * 6 + 16)
+                           + ggml_graph_overhead_custom(max_nodes, false), nullptr, true};
+    ggml_context * ctx = ggml_init(gp);
+    if (!ctx) { kv_cache_free(&next); return false; }
+    ggml_cgraph * graph = ggml_new_graph_custom(ctx, max_nodes, false);
+    for (int l = 0; l < old.n_layers; ++l) {
+        for (int v = 0; v < 2; ++v) {
+            ggml_tensor * src = v ? kv_cache_v(&old, 0, l) : kv_cache_k(&old, 0, l);
+            ggml_tensor * dst = v ? kv_cache_v(&next, 0, l) : kv_cache_k(&next, 0, l);
+            ggml_tensor * a = ggml_view_3d(ctx, src, old.head_dim, used, old.n_kv_heads,
+                                          src->nb[1], src->nb[2], 0);
+            ggml_tensor * b = ggml_view_3d(ctx, dst, old.head_dim, used, old.n_kv_heads,
+                                          dst->nb[1], dst->nb[2], 0);
+            ggml_build_forward_expand(graph, ggml_cpy(ctx, a, b));
+        }
+    }
+    ggml_gallocr_t alloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(pt->backend));
+    const bool ok = alloc && ggml_gallocr_alloc_graph(alloc, graph)
+        && backend_static_compute(pt->backend, graph) == GGML_STATUS_SUCCESS;
+    ggml_backend_synchronize(pt->backend);
+    if (alloc) ggml_gallocr_free(alloc);
+    ggml_free(ctx);
+    if (!ok) { kv_cache_free(&next); return false; }
+    next.cur_len = old.cur_len;
+    ggml_backend_sched_reset(pt->sched);
+    for (auto & g : pt->talker_decode_graphs) talker_decode_graph_free(&g);
+    kv_cache_free(&old);
+    old = std::move(next);
+    qt_log(QT_LOG_INFO, "[AdaptiveKV] grew to %d positions, preserved %d FP32 rows", capacity, used);
+    return true;
 }
 
